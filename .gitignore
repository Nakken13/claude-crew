node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Secrets
.env
.env.local
.env.*.local

# Graphify (regenerable via `graphify update .` / `graphify init`)
graphify-out/*
!graphify-out/.gitkeep

# Internal state of the crew hooks (regenerated, no value in versioning it)
crew/CLAUDE_CONTEXT/.task_state.json
crew/CLAUDE_CONTEXT/.hook_debug_dump.json
crew/CLAUDE_CONTEXT/crew_lock.json
crew/CLAUDE_CONTEXT/crew_ignored.json
crew/CLAUDE_CONTEXT/.crew_lock.mutex
crew/CLAUDE_CONTEXT/.gate_armed
crew/CLAUDE_CONTEXT/BATCH_LOCKS.md

# Venv du crew-dashboard (bootstrap projet-local via crew/dashboard.bat ;
# le lancement normal via le skill utilise ${CLAUDE_PLUGIN_ROOT}/.dashboard-venv,
# hors repo, mais gitignore quand meme au cas ou)
.dashboard-venv/

# Build outputs courants
dist/
build/
.next/
*.tsbuildinfo

# OS / editors
.DS_Store
Thumbs.db

# Claude Code — local/personal state, never shared between machines
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/crew-sessions.lock
.claude/crew-batch-metrics.json
.claude/worktrees/

# Crew tracking data (local; the crew_hook.py engine/tests/AGENTS.md stay versioned)
crew/TODO/
crew/CURRENT_TASKS/
crew/PAUSED/
crew/PROBLEMS/
crew/ICEBOX/
crew/TESTS/
crew/CLAUDE_BATCH.md
crew/CLAUDE_CONTEXT/HISTORY.md
crew/CLAUDE_CONTEXT/TASK_CHANGELOG.md
# former French names, still honored by projects that were not migrated
crew/CLAUDE_CONTEXT/HISTORIQUE.md
crew/CLAUDE_CONTEXT/CHANGELOG_TACHES.md
crew/CLAUDE_CONTEXT/TESTS_DONE/

